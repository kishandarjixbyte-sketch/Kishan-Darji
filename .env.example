# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL where this app is hosted (used in WhatsApp Admin Dashboard links & QR URLs).
APP_URL="https://kishan-darji.vercel.app"

# VITE_API_BASE_URL: Optional external backend URL. Leave empty for same-origin /api/* on Vercel, Render, or Local.
VITE_API_BASE_URL=""

# SESSION_SECRET: Secret key used to sign Admin session tokens (recommended in production, 32+ random chars).
SESSION_SECRET="CHANGE_ME_RANDOM_64_CHAR_SECRET"

# SUPABASE POSTGRESQL DATABASE (Required on Vercel for persistent storage; optional mirror locally/Render)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# WHATSAPP BUSINESS CLOUD API (Meta Graph API)
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME=""
